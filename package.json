  "devDependencies": {"@playwright/test":"^1.56.0", "@types/express":"^4.17.21", "@types/node":"^22.15.0", "@types/react":"^19.0.0", "@types/react-dom":"^19.0.0", "@types/sql.js":"^1.4.9", "@vitejs/plugin-react":"^4.4.1", "autoprefixer":"^10.4.21", "concurrently":"^9.1.2", "postcss":"^8.5.3", "tailwindcss":"^3.4.17", "tsx":"^4.19.3", "typescript":"^5.8.3", "vite":"^6.3.5"}
